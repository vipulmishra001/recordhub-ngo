# ==============================================================================
# NGO Digital Record System - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render automatically sets process.env.PORT in production)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. https://your-ngo-app.vercel.app in production)
# In development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local Development: mongodb://127.0.0.1:27017/ngo_records_db
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ngo_records_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ngo_records_db

# JWT Secret Key (MUST be at least 32 random characters in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# JWT Expiration Period
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Initial Admin Seed Credentials (used only during database seeding via npm run seed:admin)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=YourSecureAdminPassword123!
